---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStory from '../components/HeroStory.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Sidebar from '../components/Sidebar.astro';

// Fetch all news stories and sort newest first
const allNews = await getCollection('news');
const sortedArticles = allNews.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Featured article for the Hero banner
const featuredArticle = sortedArticles.find((art) => art.data.featured) || sortedArticles[0];

// Remaining articles for the grid
const gridArticles = sortedArticles.filter((art) => art.id !== featuredArticle?.id);

const categories = [
  { name: 'All Stories', href: '/' },
  { name: 'Destinations', href: '/category/destinations' },
  { name: 'Cruises & Rail', href: '/category/cruises-rail' },
  { name: 'Health & Wellness', href: '/category/health-wellness' },
  { name: 'Travel Tips', href: '/category/travel-tips' },
  { name: 'Budget & Deals', href: '/category/budget-deals' },
];
---

<BaseLayout
  title="The Ageless Voyager Journal"
  description="Curated travel guides, scenic rail journeys, health insurance insights, and winter sun escapes for active retirees and mature explorers."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12 space-y-12 lg:space-y-16">
    
    <!-- Hero / Featured Story Banner -->
    {featuredArticle && <HeroStory article={featuredArticle} />}

    <!-- Quick Category Filter Bar -->
    <div class="flex items-center justify-between gap-4 overflow-x-auto pb-2 scrollbar-none border-b border-slate-200 dark:border-slate-800">
      <div class="flex items-center gap-2 flex-nowrap">
        {categories.map((cat) => (
          <a
            href={cat.href}
            class={`px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold whitespace-nowrap transition-all ${
              cat.href === '/'
                ? 'bg-slate-900 text-white dark:bg-white dark:text-slate-900 shadow-sm'
                : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800/80'
            }`}
          >
            {cat.name}
          </a>
        ))}
      </div>
      <div class="hidden md:flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 whitespace-nowrap">
        <span>Showing {sortedArticles.length} Curated Stories</span>
      </div>
    </div>

    <!-- Main Content Area: Latest Articles Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
      
      <!-- Articles Feed (8 cols on lg) -->
      <div class="lg:col-span-8 space-y-8">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-brand-500"></span>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
              Latest Dispatches & Guides
            </h2>
          </div>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Updated This Week
          </span>
        </div>

        <!-- 2-column feed alongside sidebar -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
          {gridArticles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>

        <!-- Additional Explore Banner -->
        <div class="rounded-3xl p-8 bg-gradient-to-r from-brand-900 via-navy-950 to-slate-900 text-white relative overflow-hidden shadow-xl">
          <div class="relative z-10 max-w-xl space-y-3">
            <span class="text-xs font-bold uppercase tracking-widest text-brand-300">
              Community Spotlight
            </span>
            <h3 class="font-serif text-2xl font-bold">
              Have an inspiring retirement journey to share?
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              We publish firsthand essays and practical itineraries written by mature travelers. Send your story proposal to our editorial team.
            </p>
            <div class="pt-2">
              <a
                href="#newsletter"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-sm font-bold bg-white text-slate-900 hover:bg-brand-50 transition-colors shadow-md"
              >
                <span>Submit a Story Idea</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Sidebar (4 cols on lg) -->
      <div class="lg:col-span-4">
        <Sidebar articles={sortedArticles} />
      </div>

    </div>

  </div>
</BaseLayout>
