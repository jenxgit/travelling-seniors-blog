---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Fetch all news stories to match each persona's recent dispatches
const allNews = await getCollection('news');

// Correspondents (AI Personas)
const correspondents = [
  {
    name: 'Wren Callaway',
    role: 'Destinations Correspondent',
    type: 'AI',
    byline: 'Slow down, and always take the scenic route.',
    avatar: '/images/authors/wren-callaway.jpg',
    bio: 'Wren covers self-drive loops, heritage towns and seasonal highlights across Australia, New Zealand and Europe, with a soft spot for anywhere the coach crowds skip. Every guide includes how much walking is involved.',
    focus: ['Regional road trips', 'Slow travel', 'Seasonal blooms', 'European villages'],
    categorySlug: 'destinations',
    categoryName: 'Destinations',
  },
  {
    name: 'Hugo Ashby',
    role: 'Cruises & Rail Correspondent',
    type: 'AI',
    byline: 'The journey is the reason we travel.',
    avatar: '/images/authors/hugo-ashby.jpg',
    bio: 'A self-confessed train and ship enthusiast, Hugo explains cabin classes, booking windows and which lines suit limited mobility. Look for his "who this suits / who should skip it" box.',
    focus: ['Scenic railways', 'River & ocean cruising', 'Transcontinental trains', 'Small ships'],
    categorySlug: 'cruises-rail',
    categoryName: 'Cruises & Rail',
  },
  {
    name: 'Maya Okafor',
    role: 'Health & Wellness Correspondent',
    type: 'AI',
    byline: 'Feeling good is what keeps you travelling.',
    avatar: '/images/authors/maya-okafor.jpg',
    bio: 'Maya summarises guidance from sources like Healthdirect and Smartraveller on staying well on the road, including long flights, medications, gentle walks and wellness retreats. She names her sources, and every article reminds readers to talk to their GP.',
    focus: ['In-flight comfort', 'Medications abroad', 'Joint-friendly walks', 'Wellness escapes'],
    categorySlug: 'health-wellness',
    categoryName: 'Health & Wellness',
  },
  {
    name: 'Frank Delaney',
    role: 'Travel Tips Correspondent',
    type: 'AI',
    byline: 'Good preparation turns nerves into confidence.',
    avatar: '/images/authors/frank-delaney.jpg',
    bio: 'Frank reads the fine print so you don’t have to: insurance conditions, concession cards overseas, customs rules for prescriptions and packing systems that work.',
    focus: ['Travel insurance over 60', 'Seniors Card abroad', 'Medication & customs', 'Packing light'],
    categorySlug: 'travel-tips',
    categoryName: 'Travel Tips',
  },
  {
    name: 'Rosie Tran',
    role: 'Budget & Deals Correspondent',
    type: 'AI',
    byline: 'Spend on the experience, not the extras.',
    avatar: '/images/authors/rosie-tran.jpg',
    bio: 'Rosie tracks fare sales, exchange rates and long-stay rentals, always in Australian dollars and always with the date prices were checked. Her articles are general information, not financial advice.',
    focus: ['Off-peak fares', 'Long-stay savings', 'Aussie dollar timing', 'Loyalty points'],
    categorySlug: 'budget-deals',
    categoryName: 'Budget & Deals',
  },
];

// Helper to count articles per author
const getAuthorArticles = (authorName: string) => {
  return allNews.filter((art) => art.data.author?.name === authorName);
};
---

<BaseLayout
  title="About Our Editorial Team"
  description="Meet the editorial team behind TravellingSenior. Our correspondents are AI writing personas guided, fact-checked, and signed off by our human editor, Pat."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-16 lg:space-y-20">
    
    <!-- Hero Header -->
    <header class="relative rounded-3xl p-8 sm:p-12 lg:p-16 overflow-hidden bg-gradient-to-br from-navy-950 via-slate-900 to-navy-900 text-white border border-white/10 shadow-2xl space-y-6">
      <div class="absolute right-0 top-0 w-96 h-96 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute left-1/4 -bottom-10 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-bold uppercase tracking-wider bg-brand-500/20 text-brand-300 border border-brand-500/30 backdrop-blur-sm">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Editorial Transparency
        </div>
        
        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
          Meet the Editorial Team
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Our correspondents are AI writing personas, each with their own section, voice and interests. Our human editor sets the story list, checks facts and prices, and signs off on every article.
        </p>
      </div>
    </header>



    <!-- Correspondents Section -->
    <section class="space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div class="space-y-2">
          <span class="text-xs font-bold uppercase tracking-widest text-brand-600 dark:text-brand-400">
            Section Specialists
          </span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
            Our Writing Personas
          </h2>
          <p class="text-slate-600 dark:text-slate-400 text-sm max-w-2xl">
            Each AI correspondent focuses on a specialised travel beat with dedicated criteria, tailored guidance, and clear disclaimers.
          </p>
        </div>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
          5 AI Correspondents
        </span>
      </div>

      <!-- Correspondents Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {correspondents.map((person) => {
          const authorArticles = getAuthorArticles(person.name);
          return (
            <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-slate-200/80 dark:border-slate-800 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between space-y-6">
              
              <div class="space-y-5">
                <!-- Profile Header -->
                <div class="flex items-start gap-4 sm:gap-6">
                  <div class="relative flex-shrink-0">
                    <img
                      src={person.avatar}
                      alt={person.name}
                      class="w-20 h-20 sm:w-24 sm:h-24 rounded-full object-cover ring-4 ring-brand-500/30 shadow-md"
                      loading="lazy"
                    />
                    <div class="absolute -bottom-1 -right-1 px-1.5 py-0.5 rounded-full bg-slate-900 text-white dark:bg-slate-800 dark:text-brand-300 text-[10px] font-bold shadow-sm border border-white/20">
                      AI
                    </div>
                  </div>

                  <div class="space-y-1.5 flex-1 min-w-0">
                    <div class="flex items-center justify-between gap-2">
                      <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900 dark:text-white truncate">
                        {person.name}
                      </h3>
                      <a
                        href={`/category/${person.categorySlug}`}
                        class="text-[11px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 hover:bg-brand-100 transition-colors whitespace-nowrap"
                      >
                        {person.categoryName}
                      </a>
                    </div>

                    <p class="text-xs sm:text-sm font-semibold text-brand-600 dark:text-brand-400">
                      {person.role} ({person.type})
                    </p>
                  </div>
                </div>

                <!-- Byline Quote Callout -->
                <blockquote class="p-3.5 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border-l-4 border-brand-500 text-xs sm:text-sm italic text-slate-700 dark:text-slate-300">
                  “{person.byline}”
                </blockquote>

                <!-- Bio -->
                <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
                  {person.bio}
                </p>

                <!-- Focus Areas -->
                <div class="space-y-2">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                    Focus Areas
                  </span>
                  <div class="flex flex-wrap gap-1.5">
                    {person.focus.map((item) => (
                      <span class="px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              </div>

              <!-- Footer with recent articles link -->
              <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between text-xs">
                <span class="text-slate-500 dark:text-slate-400 font-medium">
                  {authorArticles.length} published guide{authorArticles.length === 1 ? '' : 's'}
                </span>
                <a
                  href={`/category/${person.categorySlug}`}
                  class="inline-flex items-center gap-1 font-bold text-brand-600 dark:text-brand-400 hover:text-brand-700 dark:hover:text-brand-300 transition-colors"
                >
                  <span>Explore stories by {person.name.split(' ')[0]}</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>

            </div>
          );
        })}
      </div>
    </section>

    <!-- Editorial Standards & Reader Trust -->
    <section class="rounded-3xl p-8 sm:p-12 bg-gradient-to-br from-slate-900 via-navy-950 to-slate-900 text-white relative overflow-hidden border border-white/10 shadow-xl space-y-6">
      <div class="relative z-10 max-w-3xl space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400">
          Our Editorial Code
        </span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold">
          Fact-Checked, Transparent & Human-Reviewed
        </h2>
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
          Every guide published on TravellingSenior goes through human editorial review for accuracy, currency, and tone. Pricing is presented in Australian dollars with verified check dates, and health topics always incorporate authoritative guidance and GP reminders.
        </p>
        <div class="pt-2 flex flex-wrap gap-4">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-brand-500 hover:bg-brand-600 text-white shadow-md transition-colors"
          >
            <span>Browse All Curated Guides</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a
            href="/privacy"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs sm:text-sm font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/10 transition-colors"
          >
            Privacy & Editorial Policy
          </a>
        </div>
      </div>
    </section>

  </div>
</BaseLayout>
