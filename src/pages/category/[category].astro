---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';

export async function getStaticPaths() {
  const allNews = await getCollection('news');
  
  // Extract unique categories
  const categories = Array.from(new Set(allNews.map((article) => article.data.category)));

  return categories.map((category) => {
    const slug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    const filteredArticles = allNews
      .filter((article) => article.data.category === category)
      .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

    return {
      params: { category: slug },
      props: {
        categoryName: category,
        articles: filteredArticles,
      },
    };
  });
}

const { categoryName, articles } = Astro.props;

const categoryDescriptions: Record<string, string> = {
  'Destinations': 'Curated slow-travel guides, sunny winter retreats, and accessible European hotspots for retired explorers.',
  'Cruises & Rail': 'Panoramic rail routes, scenic river cruises, and comfortable multi-country transit without airport fatigue.',
  'Health & Wellness': 'Onsen retreats, thermal spas, gentle walking itineraries, and age-positive vitality tips.',
  'Travel Tips': 'Pre-existing medical insurance advice, packing hacks, luggage transfer services, and accessibility guides.',
  'Budget & Deals': 'Senior rail discounts, long-stay apartment savings, off-season snowbird strategies, and currency tips.',
};

const currentDescription =
  categoryDescriptions[categoryName] ||
  `Browse our curated collection of ${categoryName.toLowerCase()} articles tailored for mature travelers.`;
---

<BaseLayout
  title={`${categoryName} News & Guides`}
  description={currentDescription}
  category={categoryName}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-12">
    
    <!-- Category Header Banner -->
    <header class="relative rounded-3xl p-8 sm:p-12 overflow-hidden bg-gradient-to-br from-navy-950 via-slate-900 to-navy-900 text-white border border-white/10 shadow-xl">
      <div class="absolute right-0 top-0 w-96 h-96 bg-brand-500/15 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl space-y-4">
        <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <span class="text-brand-400">Categories</span>
          <span>/</span>
          <span class="text-white">{categoryName}</span>
        </nav>

        <div class="flex flex-wrap items-center gap-3">
          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white">
            {categoryName}
          </h1>
          <span class="px-3 py-1 rounded-full text-xs font-bold bg-brand-500/30 text-amber-300 border border-brand-500/40">
            {articles.length} {articles.length === 1 ? 'Article' : 'Articles'}
          </span>
        </div>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          {currentDescription}
        </p>
      </div>
    </header>

    <!-- Articles Grid (3-column responsive layout) -->
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {articles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <div class="rounded-3xl p-12 text-center glass-panel space-y-4">
        <p class="text-slate-500 dark:text-slate-400 text-lg">
          No articles found in this category yet.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-white bg-brand-600 hover:bg-brand-500 transition-colors"
        >
          Return to Homepage
        </a>
      </div>
    )}

    <!-- Category Switcher Footer -->
    <div class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
        Explore Other Categories:
      </span>
      <div class="flex flex-wrap gap-2">
        <a
          href="/category/destinations"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white transition-colors"
        >
          Destinations
        </a>
        <a
          href="/category/cruises-rail"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white transition-colors"
        >
          Cruises & Rail
        </a>
        <a
          href="/category/health-wellness"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white transition-colors"
        >
          Health & Wellness
        </a>
        <a
          href="/category/travel-tips"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white transition-colors"
        >
          Travel Tips
        </a>
        <a
          href="/category/budget-deals"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white transition-colors"
        >
          Budget & Deals
        </a>
      </div>
    </div>

  </div>
</BaseLayout>
