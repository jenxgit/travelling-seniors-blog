---
// Footer.astro
const currentYear = new Date().getFullYear();

const categories = [
  { name: 'Destinations', href: '/category/destinations' },
  { name: 'Cruises & Rail', href: '/category/cruises-rail' },
  { name: 'Health & Wellness', href: '/category/health-wellness' },
  { name: 'Travel Tips', href: '/category/travel-tips' },
  { name: 'Budget & Deals', href: '/category/budget-deals' },
];

const guides = [
  { name: 'Senior Rail Passes & Discounts', href: '/news/scenic-rail-journeys-europe' },
  { name: 'Travel Insurance over 60 & 70', href: '/news/essential-travel-health-insurance-guide' },
  { name: 'Winter Sun Snowbird Escapes', href: '/news/smart-budgeting-long-stay-snowbirds' },
  { name: 'Accessible European Walkways', href: '/news/hidden-gems-portugal-algarve-seniors' },
];
---

<footer class="mt-auto border-t border-slate-200 dark:border-slate-800 bg-white/70 dark:bg-slate-950/70 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 lg:py-18">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Brand & Bio (2 cols on lg) -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-brand-600 to-amber-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10" />
              <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76" fill="currentColor" fill-opacity="0.3"/>
            </svg>
          </div>
          <span class="font-serif text-2xl font-bold tracking-tight text-slate-900 dark:text-white">
            TravellingSenior
          </span>
        </a>
        <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed max-w-sm">
          The premier independent digital journal dedicated to inspiring comfortable, culturally rich, and budget-conscious journeys for active retirees and mature travelers worldwide.
        </p>
        <div class="flex items-center gap-3 pt-2 text-slate-500 dark:text-slate-400">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 dark:bg-brand-950/50 text-brand-700 dark:text-brand-300 border border-brand-200 dark:border-brand-800/40">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Independent Editorial
          </span>
          <span class="text-xs text-slate-400">• Age-Positive Travel</span>
        </div>
      </div>

      <!-- Categories -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-widest text-slate-900 dark:text-white mb-4">
          Categories
        </h3>
        <ul class="space-y-2.5 text-sm">
          {categories.map((cat) => (
            <li>
              <a
                href={cat.href}
                class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors"
              >
                {cat.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Essential Guides -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-widest text-slate-900 dark:text-white mb-4">
          Essential Guides
        </h3>
        <ul class="space-y-2.5 text-sm">
          {guides.map((guide) => (
            <li>
              <a
                href={guide.href}
                class="text-slate-600 dark:text-slate-400 hover:text-brand-600 dark:hover:text-brand-400 transition-colors line-clamp-1"
              >
                {guide.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Editorial Newsletter Info -->
      <div>
        <h3 class="font-semibold text-xs uppercase tracking-widest text-slate-900 dark:text-white mb-4">
          Join 28,000+ Readers
        </h3>
        <p class="text-xs text-slate-600 dark:text-slate-400 mb-3 leading-relaxed">
          Receive our hand-picked destination spotlight and senior discount alerts every Thursday morning.
        </p>
        <a
          href="#newsletter"
          class="inline-flex items-center gap-1.5 text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline"
        >
          <span>Subscribe free to The Digest</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200/80 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-500">
      <p>© {currentYear} TravellingSenior Journal. All rights reserved. Content curated for mature explorers.</p>
      <div class="flex items-center gap-6">
        <a href="/" class="hover:text-slate-800 dark:hover:text-slate-300 transition-colors">Privacy Policy</a>
        <a href="/" class="hover:text-slate-800 dark:hover:text-slate-300 transition-colors">Accessibility Statement</a>
        <a href="/" class="hover:text-slate-800 dark:hover:text-slate-300 transition-colors">Editorial Ethics</a>
      </div>
    </div>
  </div>
</footer>
