---
// ReadingProgressBar.astro
---

<div id="reading-progress-container" class="fixed top-0 left-0 w-full h-1 z-50 pointer-events-none bg-transparent">
  <div
    id="reading-progress-bar"
    class="h-full bg-gradient-to-r from-brand-600 via-amber-500 to-brand-400 w-0 transition-all duration-75"
  ></div>
</div>

<script is:inline>
  const initProgressBar = () => {
    const bar = document.getElementById('reading-progress-bar');
    if (!bar) return;

    const updateProgress = () => {
      const scrollTotal = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (window.scrollY / scrollTotal) * 100;
      bar.style.width = `${Math.min(100, Math.max(0, scrolled))}%`;
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  };

  initProgressBar();
  document.addEventListener('astro:after-swap', initProgressBar);
</script>
