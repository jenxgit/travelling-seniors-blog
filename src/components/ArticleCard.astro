---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'news'>;
  layout?: 'standard' | 'compact' | 'featured';
}

const { article } = Astro.props;
const { title, description, pubDate, category, author, image, tags, readingTime } = article.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
}).format(pubDate);

const slug = article.id;
const categorySlug = category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
---

<article class="group flex flex-col h-full rounded-2xl glass-card overflow-hidden hover:shadow-xl hover:border-brand-500/30 hover:-translate-y-1 transition-all duration-300">
  <!-- Article Thumbnail Container -->
  <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-800">
    <img
      src={image.url}
      alt={image.alt}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
    
    <!-- Category Badge -->
    <div class="absolute top-3.5 left-3.5">
      <a
        href={`/category/${categorySlug}`}
        class="inline-block px-2.5 py-1 rounded-lg text-xs font-bold uppercase tracking-wider bg-white/90 dark:bg-slate-900/90 text-brand-700 dark:text-brand-400 backdrop-blur-md shadow-sm hover:bg-brand-500 hover:text-white transition-colors"
      >
        {category}
      </a>
    </div>

    <!-- Reading Time Badge -->
    <div class="absolute bottom-3 right-3 bg-black/60 backdrop-blur-md px-2 py-0.5 rounded text-[11px] font-medium text-white/90">
      {readingTime || '5 min read'}
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between gap-4">
    <div class="space-y-2.5">
      <!-- Date & Reading Time -->
      <div class="flex items-center gap-2 text-xs font-semibold text-slate-500 dark:text-slate-400">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>•</span>
        <span class="text-brand-600 dark:text-brand-400">{category}</span>
      </div>

      <!-- Title -->
      <h3 class="font-serif text-xl sm:text-xl font-bold text-slate-900 dark:text-white leading-snug group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2">
        <a href={`/news/${slug}`}>
          {title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed line-clamp-2 font-normal">
        {description}
      </p>

      {tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {tags.slice(0, 2).map((tag) => (
            <span class="text-[10px] px-2 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 font-medium">
              #{tag}
            </span>
          ))}
        </div>
      )}
    </div>

    <!-- Tags & Author Metadata -->
    <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-3">
      <!-- Author info -->
      <div class="flex items-center gap-2.5 min-w-0">
        <img
          src={author.avatar}
          alt={author.name}
          class="w-7 h-7 rounded-full object-cover ring-1 ring-slate-200 dark:ring-slate-700 flex-shrink-0"
        />
        <div class="truncate">
          <div class="text-xs font-bold text-slate-900 dark:text-white truncate">{author.name}</div>
        </div>
      </div>

      <!-- Read more arrow -->
      <a
        href={`/news/${slug}`}
        class="inline-flex items-center gap-1 text-xs font-bold text-brand-600 dark:text-brand-400 group-hover:translate-x-0.5 transition-transform"
        aria-label={`Read ${title}`}
      >
        <span>Read</span>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</article>
