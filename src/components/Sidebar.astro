---
import type { CollectionEntry } from 'astro:content';

interface Props {
  articles: CollectionEntry<'news'>[];
}

const { articles } = Astro.props;

// Sort articles for trending
const trendingArticles = [...articles].slice(0, 4);

// Categories with counts
const categoriesMap = articles.reduce((acc, art) => {
  const cat = art.data.category;
  acc[cat] = (acc[cat] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categoryList = Object.entries(categoriesMap).map(([name, count]) => ({
  name,
  count,
  slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, ''),
}));
---

<aside class="space-y-8">
  
  <!-- Newsletter Signup Card -->
  <div id="newsletter" class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-950 via-slate-900 to-navy-900 text-white p-6 sm:p-7 border border-white/10 shadow-xl">
    <div class="absolute -right-8 -top-8 w-32 h-32 bg-brand-500/20 rounded-full blur-2xl"></div>
    
    <div class="relative space-y-4">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-brand-500/20 text-brand-400 border border-brand-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-400 animate-ping"></span>
        Free Weekly Dispatch
      </div>

      <h3 class="font-serif text-2xl font-bold leading-tight">
        Weekly Travel Digest
      </h3>

      <p class="text-slate-300 text-sm leading-relaxed">
        Get all the latest news, senior travel guides, and exclusive deals delivered directly to your inbox every Thursday.
      </p>

      <form
        id="newsletter-form"
        action="https://travellingseniors.us2.list-manage.com/subscribe/post?u=95af8ab2d0f333edafcc3c6d8&amp;id=3b0394500e&amp;f_id=000bf6e3f0"
        method="post"
        target="_blank"
        class="space-y-3 pt-1"
      >
        <div class="relative">
          <input
            type="email"
            name="EMAIL"
            id="newsletter-email"
            placeholder="Enter your email address..."
            required
            class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400 focus:bg-white/15 transition-all"
          />
        </div>

        <!-- Bot honeypot protection field -->
        <div aria-hidden="true" style="position: absolute; left: -5000px;">
          <input type="text" name="b_95af8ab2d0f333edafcc3c6d8_3b0394500e" tabindex="-1" value="" autocomplete="off" />
        </div>

        <button
          type="submit"
          id="newsletter-submit-btn"
          class="w-full py-3 px-4 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-brand-600 to-amber-500 hover:from-brand-500 hover:to-amber-400 shadow-md shadow-brand-500/30 active:scale-[0.98] transition-all flex items-center justify-center gap-2 disabled:opacity-75 disabled:cursor-not-allowed cursor-pointer"
        >
          <span id="newsletter-btn-text">Subscribe Free</span>
          <svg id="newsletter-btn-icon" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
          <svg id="newsletter-btn-spinner" class="hidden w-4 h-4 animate-spin text-white" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </button>

        <p class="text-[11px] text-slate-400 text-center">
          No spam, ever. Unsubscribe with 1-click anytime.
        </p>
      </form>

      <!-- Feedback alert - Error -->
      <div id="newsletter-error" class="hidden p-3.5 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-200 text-xs font-medium text-center animate-fade-in">
        <p id="newsletter-error-text">Something went wrong. Please check your email and try again.</p>
      </div>

      <!-- Feedback alert - Success -->
      <div id="newsletter-success" class="hidden p-3.5 rounded-xl bg-emerald-950/80 border border-emerald-500/40 text-emerald-200 text-xs font-semibold text-center animate-fade-in space-y-1">
        <p class="font-bold text-sm">✓ Welcome aboard!</p>
        <p id="newsletter-success-text" class="text-slate-200 font-normal">Please check your inbox to confirm your subscription.</p>
      </div>
    </div>
  </div>

  <!-- Trending / Most Read Section -->
  <div class="rounded-3xl glass-panel p-6 sm:p-7 space-y-5">
    <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-500"></span>
        <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white">
          Trending Stories
        </h3>
      </div>
      <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Most Read</span>
    </div>

    <div class="space-y-4">
      {trendingArticles.map((item, idx) => {
        const slug = item.id;
        const formattedDate = new Intl.DateTimeFormat('en-US', {
          month: 'short',
          day: 'numeric',
        }).format(item.data.pubDate);

        return (
          <article class="group flex items-start gap-4">
            <!-- Rank Number -->
            <span class="font-serif text-2xl font-bold text-slate-300 dark:text-slate-700 group-hover:text-brand-500 transition-colors w-6 flex-shrink-0">
              0{idx + 1}
            </span>

            <!-- Content -->
            <div class="space-y-1 min-w-0">
              <span class="text-[11px] font-bold text-brand-600 dark:text-brand-400 uppercase tracking-wide">
                {item.data.category}
              </span>
              <h4 class="font-serif text-sm font-bold text-slate-800 dark:text-slate-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2 leading-snug">
                <a href={`/news/${slug}`}>
                  {item.data.title}
                </a>
              </h4>
              <div class="flex items-center gap-2 text-[11px] text-slate-500 dark:text-slate-400">
                <time datetime={item.data.pubDate.toISOString()}>{formattedDate}</time>
                <span>•</span>
                <span>{item.data.readingTime || '5 min'}</span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <!-- Explore Categories List -->
  <div class="rounded-3xl glass-panel p-6 sm:p-7 space-y-4">
    <h3 class="font-serif text-lg font-bold text-slate-900 dark:text-white border-b border-slate-200 dark:border-slate-800 pb-3">
      Explore Topics
    </h3>

    <div class="flex flex-wrap gap-2">
      {categoryList.map((cat) => (
        <a
          href={`/category/${cat.slug}`}
          class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-semibold bg-slate-100 dark:bg-slate-800/80 text-slate-700 dark:text-slate-300 hover:bg-brand-500 hover:text-white dark:hover:bg-brand-500 dark:hover:text-white transition-all"
        >
          <span>{cat.name}</span>
          <span class="px-1.5 py-0.5 rounded-full text-[10px] bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-bold group-hover:bg-white/20">
            {cat.count}
          </span>
        </a>
      ))}
    </div>
  </div>

  <!-- Senior Travel Tip Callout -->
  <div class="rounded-3xl p-6 bg-gradient-to-br from-amber-500/10 via-brand-500/10 to-transparent border border-brand-500/20 space-y-3">
    <div class="flex items-center gap-2 text-brand-700 dark:text-brand-400 font-bold text-xs uppercase tracking-wider">
      <span>💡</span>
      <span>Weekly Explorer Tip</span>
    </div>
    <h4 class="font-serif font-bold text-slate-900 dark:text-white text-base">
      Ask for the "Golden Age" Concession
    </h4>
    <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
      In many European museums, national parks, and ferries, senior discounts aren't advertised on main price boards. Always ask ticket agents for the <em>Tarifa Reducida</em> or <em>Senior Rate</em> with your ID!
    </p>
  </div>

</aside>

<script is:inline>
  const initNewsletter = () => {
    const form = document.getElementById('newsletter-form');
    const input = document.getElementById('newsletter-email');
    const submitBtn = document.getElementById('newsletter-submit-btn');
    const btnText = document.getElementById('newsletter-btn-text');
    const btnIcon = document.getElementById('newsletter-btn-icon');
    const btnSpinner = document.getElementById('newsletter-btn-spinner');
    const successMsg = document.getElementById('newsletter-success');
    const successText = document.getElementById('newsletter-success-text');
    const errorMsg = document.getElementById('newsletter-error');
    const errorText = document.getElementById('newsletter-error-text');

    if (!form || !input || form.dataset.mailchimpBound) return;
    form.dataset.mailchimpBound = 'true';

    const setLoading = (loading) => {
      if (submitBtn) submitBtn.disabled = loading;
      if (btnText) btnText.textContent = loading ? 'Subscribing...' : 'Subscribe Free';
      if (btnIcon) btnIcon.classList.toggle('hidden', loading);
      if (btnSpinner) btnSpinner.classList.toggle('hidden', !loading);
    };

    const stripHtml = (html) => {
      const tmp = document.createElement('div');
      tmp.innerHTML = html;
      return tmp.textContent || tmp.innerText || '';
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = input.value.trim();
      if (!email) return;

      if (errorMsg) errorMsg.classList.add('hidden');
      setLoading(true);

      const callbackName = 'mc_cb_' + Date.now() + '_' + Math.floor(Math.random() * 10000);
      const script = document.createElement('script');

      const timeoutId = setTimeout(() => {
        setLoading(false);
        // If JSONP times out, fallback to normal submission
        form.submit();
      }, 7000);

      window[callbackName] = (resp) => {
        clearTimeout(timeoutId);
        if (script.parentNode) document.body.removeChild(script);
        delete window[callbackName];
        setLoading(false);

        if (resp && resp.result === 'success') {
          form.classList.add('hidden');
          if (errorMsg) errorMsg.classList.add('hidden');
          if (successText && resp.msg) {
            const cleanMsg = stripHtml(resp.msg);
            if (cleanMsg) successText.textContent = cleanMsg;
          }
          if (successMsg) successMsg.classList.remove('hidden');
        } else {
          let err = (resp && resp.msg) ? resp.msg : 'An error occurred. Please try again.';
          err = stripHtml(err);
          if (err.startsWith('0 - ')) err = err.substring(4);
          if (err.toLowerCase().includes('already subscribed')) {
            err = "You're already subscribed to our weekly digest! Thank you.";
          }
          if (errorText) errorText.textContent = err;
          if (errorMsg) errorMsg.classList.remove('hidden');
        }
      };

      script.src = `https://travellingseniors.us2.list-manage.com/subscribe/post-json?u=95af8ab2d0f333edafcc3c6d8&id=3b0394500e&f_id=000bf6e3f0&EMAIL=${encodeURIComponent(email)}&b_95af8ab2d0f333edafcc3c6d8_3b0394500e=&c=${callbackName}`;
      script.onerror = () => {
        clearTimeout(timeoutId);
        if (script.parentNode) document.body.removeChild(script);
        delete window[callbackName];
        setLoading(false);
        form.submit();
      };

      document.body.appendChild(script);
    });
  };

  initNewsletter();
  document.addEventListener('astro:page-load', initNewsletter);
  document.addEventListener('astro:after-swap', initNewsletter);
</script>
